;; SRV ERPNext Bridge trigger for TallyPrime 7.x
;; The local Python bridge keeps credentials out of TDL and performs the sync.

[#Menu: Gateway of Tally]
    Add : Key Item : Before : @@locQuit : ERPNext Sales Sync : E : Call : SRV ERP Sync

[Function: SRV ERP Sync]
    010 : HTTP Request : "http://127.0.0.1:8765/sync" : GET : JSONEX : ASCII : SRV ERP Sync Request : SRV ERP Sync Complete
    020 : Return

[Function: SRV ERP Sync Complete]
    010 : Msg Box : "ERPNext Sync" : "Sync request completed. Open Tally Bridge logs for the detailed result."
    020 : Return

;; TallyPrime requires a valid request-report description even for a GET.
;; The report body is ignored for GET; its Accept header requests JSON.
[Report: SRV ERP Sync Request]
    Form          : SRV ERP Sync Request Form
    Export Header : "Accept: application/json"

[Form: SRV ERP Sync Request Form]
    Part : SRV ERP Sync Request Part

[Part: SRV ERP Sync Request Part]
    Line : SRV ERP Sync Request Line

[Line: SRV ERP Sync Request Line]
    Field : SRV ERP Sync Request Field

[Field: SRV ERP Sync Request Field]
    Set As : ""
