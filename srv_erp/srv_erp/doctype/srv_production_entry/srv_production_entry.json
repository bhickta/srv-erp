{
 "doctype": "DocType",
 "name": "SRV Production Entry",
 "module": "Srv Erp",
 "engine": "InnoDB",
 "field_order": [
  "entry_details",
  "schedule",
  "company",
  "supervisor",
  "entry_date_column",
  "production_date",
  "schedule_date",
  "work_area",
  "entry_status_column",
  "status",
  "item_count",
  "output_section",
  "items",
  "remarks_section",
  "remarks",
  "notice",
  "amended_from",
  "assignment",
  "template",
  "item_code",
  "qty",
  "uom"
 ],
 "fields": [
  {
   "fieldname": "entry_details",
   "fieldtype": "Section Break",
   "label": "Production Entry"
  },
  {
   "fieldname": "schedule",
   "fieldtype": "Data",
   "label": "Production Schedule",
   "reqd": 1,
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "read_only": 1,
   "reqd": 1
  },
  {
   "fieldname": "supervisor",
   "fieldtype": "Link",
   "label": "Supervisor",
   "options": "User",
   "read_only": 1,
   "reqd": 1
  },
  {
   "fieldname": "entry_date_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "production_date",
   "fieldtype": "Date",
   "label": "Production Date",
   "reqd": 1,
   "default": "Today",
   "in_list_view": 1
  },
  {
   "fieldname": "schedule_date",
   "fieldtype": "Date",
   "label": "Schedule Date",
   "read_only": 1,
   "description": "Earliest source item date."
  },
  {
   "fieldname": "work_area",
   "fieldtype": "Link",
   "label": "Work Area / Operation",
   "read_only": 1,
   "in_list_view": 1,
   "options": "Operation"
  },
  {
   "fieldname": "entry_status_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nSubmitted\nCancelled",
   "default": "Draft",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "item_count",
   "fieldtype": "Int",
   "label": "Output Lines",
   "read_only": 1
  },
  {
   "fieldname": "output_section",
   "fieldtype": "Section Break",
   "label": "Produced Items"
  },
  {
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "Items",
   "options": "SRV Production Entry Item",
   "reqd": 1
  },
  {
   "fieldname": "remarks_section",
   "fieldtype": "Section Break",
   "label": "Remarks",
   "collapsible": 1
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "Remarks"
  },
  {
   "fieldname": "notice",
   "fieldtype": "HTML",
   "label": "Notice",
   "options": "<p>Records production quantities and plan progress. This entry does not update stock.</p>"
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "label": "Amended From",
   "options": "SRV Production Entry",
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldname": "assignment",
   "fieldtype": "Link",
   "label": "Assignment",
   "options": "SRV Production Assignment",
   "reqd": 0,
   "in_list_view": 0,
   "in_standard_filter": 1,
   "hidden": 1,
   "read_only": 1
  },
  {
   "fieldname": "template",
   "fieldtype": "Link",
   "label": "Template",
   "options": "Item",
   "read_only": 1,
   "reqd": 0,
   "hidden": 1,
   "in_list_view": 0
  },
  {
   "fieldname": "item_code",
   "fieldtype": "Link",
   "label": "Item Code",
   "options": "Item",
   "reqd": 0,
   "in_list_view": 0,
   "description": "A concrete variant of the planned template.",
   "hidden": 1,
   "read_only": 1
  },
  {
   "fieldname": "qty",
   "fieldtype": "Float",
   "label": "Qty",
   "reqd": 0,
   "precision": "6",
   "in_list_view": 0,
   "description": "Actual output in the variant stock UOM.",
   "hidden": 1,
   "read_only": 1
  },
  {
   "fieldname": "uom",
   "fieldtype": "Link",
   "label": "Uom",
   "options": "UOM",
   "read_only": 1,
   "reqd": 0,
   "hidden": 1,
   "in_list_view": 0
  }
 ],
 "permissions": [
  {
   "role": "SRV Production Planner",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1
  },
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1
  },
  {
   "role": "SRV Production Supervisor",
   "read": 1,
   "create": 1,
   "write": 1,
   "submit": 1,
   "report": 1,
   "print": 1
  }
 ],
 "track_changes": 1,
 "sort_field": "creation",
 "sort_order": "DESC",
 "is_submittable": 1,
 "autoname": "hash",
 "naming_rule": "Random",
 "title_field": "schedule"
}
