{
 "doctype": "DocType",
 "name": "SRV Production Entry",
 "module": "Srv Erp",
 "engine": "InnoDB",
 "field_order": [
  "notice",
  "assignment",
  "company",
  "template",
  "supervisor",
  "production_date",
  "item_code",
  "qty",
  "uom",
  "remarks",
  "amended_from"
 ],
 "fields": [
  {
   "fieldname": "notice",
   "fieldtype": "HTML",
   "label": "Notice",
   "options": "<p>Records production quantities and plan progress. This entry does not update stock.</p>"
  },
  {
   "fieldname": "assignment",
   "fieldtype": "Link",
   "label": "Assignment",
   "options": "SRV Production Assignment",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "read_only": 1,
   "reqd": 1
  },
  {
   "fieldname": "template",
   "fieldtype": "Link",
   "label": "Template",
   "options": "Item",
   "read_only": 1,
   "reqd": 1
  },
  {
   "fieldname": "supervisor",
   "fieldtype": "Link",
   "label": "Supervisor",
   "options": "User",
   "read_only": 1,
   "reqd": 1
  },
  {
   "fieldname": "production_date",
   "fieldtype": "Date",
   "label": "Production Date",
   "reqd": 1,
   "default": "Today",
   "in_list_view": 1
  },
  {
   "fieldname": "item_code",
   "fieldtype": "Link",
   "label": "Item Code",
   "options": "Item",
   "reqd": 1,
   "in_list_view": 1,
   "description": "A concrete variant of the planned template."
  },
  {
   "fieldname": "qty",
   "fieldtype": "Float",
   "label": "Qty",
   "reqd": 1,
   "precision": "6",
   "in_list_view": 1,
   "description": "Actual output in the variant stock UOM."
  },
  {
   "fieldname": "uom",
   "fieldtype": "Link",
   "label": "Uom",
   "options": "UOM",
   "read_only": 1,
   "reqd": 1
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "Remarks"
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "label": "Amended From",
   "options": "SRV Production Entry",
   "read_only": 1,
   "no_copy": 1
  }
 ],
 "permissions": [
  {
   "role": "SRV Production Planner",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1
  },
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1
  },
  {
   "role": "SRV Production Supervisor",
   "read": 1,
   "create": 1,
   "write": 1,
   "submit": 1,
   "report": 1,
   "print": 1
  }
 ],
 "track_changes": 1,
 "sort_field": "creation",
 "sort_order": "DESC",
 "is_submittable": 1,
 "autoname": "hash",
 "naming_rule": "Random",
 "title_field": "assignment"
}
