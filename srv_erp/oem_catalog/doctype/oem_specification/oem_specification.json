    },
    {
      "role": "OEM Catalog Approver",
      "read": 1
    },
    {
      "role": "OEM Catalog Manager",
      "read": 1
    }
  ],
  "istable": 0,
  "issingle": 0,
  "track_changes": 0,
  "sort_field": "modified",
  "sort_order": "DESC"
}
