      "fieldtype": "Link",
      "reqd": 1,
      "options": "OEM Asset",
      "in_list_view": 1
    },
    {
      "fieldname": "revision",
      "label": "Revision",
      "fieldtype": "Int",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "state",
      "label": "State",
      "fieldtype": "Select",
      "default": "Draft",
      "options": "Draft\nApproved\nRetired",
      "in_list_view": 1
    },
    {
      "fieldname": "private_file",
      "label": "Private File",
      "fieldtype": "Link",
      "reqd": 1,
      "options": "File"
    },
    {
      "fieldname": "content_sha256",
      "label": "Content Sha256",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "physical_reference",
      "label": "Physical Reference",
      "fieldtype": "Data"
    },
    {
      "fieldname": "certification_scheme",
      "label": "Certification Scheme",
      "fieldtype": "Data"
    },
    {
      "fieldname": "valid_from",
      "label": "Valid From",
      "fieldtype": "Date"
    },
    {
      "fieldname": "valid_until",
      "label": "Valid Until",
      "fieldtype": "Date"
    },
    {
      "fieldname": "approved_by",
      "label": "Approved By",
      "fieldtype": "Link",
      "read_only": 1,
      "options": "User",
      "in_list_view": 1
    },
    {
      "fieldname": "approved_on",
      "label": "Approved On",
      "fieldtype": "Datetime"
    }
