{
  "doctype": "DocType",
  "name": "OEM Asset Revision",
  "module": "OEM Catalog",
  "engine": "InnoDB",
  "autoname": "hash",
  "field_order": [
    "asset",
    "revision",
    "state",
    "private_file",
    "content_sha256",
    "physical_reference",
    "certification_scheme",
    "valid_from",
    "valid_until",
    "approved_by",
    "approved_on"
  ],
  "fields": [
    {
      "fieldname": "asset",
