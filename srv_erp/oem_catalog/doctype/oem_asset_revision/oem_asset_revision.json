  "title_field": "asset",
  "search_fields": "asset,state",
  "show_title_field_in_link": 1,
  "permissions": [
    {
      "role": "OEM Catalog Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    },
    {
      "role": "OEM Catalog User",
      "read": 1
    },
    {
      "role": "OEM Catalog Approver",
      "read": 1
    }
  ],
  "istable": 0,
  "issingle": 0,
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC"
}
