{
  "doctype": "DocType",
  "name": "OEM Command Receipt",
  "module": "OEM Catalog",
  "engine": "InnoDB",
  "autoname": "hash",
  "field_order": [
    "command_key",
    "actor",
    "operation",
    "payload_hash",
    "state",
    "result_json",
    "created_on"
  ],
  "fields": [
    {
      "fieldname": "command_key",
      "label": "Command Key",
      "fieldtype": "Data",
      "unique": 1,
      "reqd": 1
    },
    {
      "fieldname": "actor",
      "label": "Actor",
      "fieldtype": "Link",
      "options": "User",
      "in_list_view": 1
    },
    {
      "fieldname": "operation",
      "label": "Operation",
      "fieldtype": "Data",
      "in_list_view": 1
    },
    {
      "fieldname": "payload_hash",
      "label": "Payload Hash",
      "fieldtype": "Data"
    },
    {
      "fieldname": "state",
      "label": "State",
      "fieldtype": "Select",
      "options": "Processing\nCompleted",
      "in_list_view": 1
    },
    {
      "fieldname": "result_json",
      "label": "Result Json",
      "fieldtype": "Long Text"
    },
    {
      "fieldname": "created_on",
      "label": "Created On",
      "fieldtype": "Datetime",
      "in_list_view": 1
    }
  ],
  "title_field": "operation",
  "search_fields": "operation,actor,state",
  "show_title_field_in_link": 1,
  "permissions": [
    {
      "role": "OEM Catalog User",
      "read": 1
    },
    {
      "role": "OEM Catalog Approver",
      "read": 1
    },
    {
      "role": "OEM Catalog Manager",
      "read": 1
    }
  ],
  "istable": 0,
  "issingle": 0,
  "track_changes": 0,
  "sort_field": "modified",
  "sort_order": "DESC"
}
